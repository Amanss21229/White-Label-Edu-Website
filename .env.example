# Required secrets — generate unique strong values. Never commit the real .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-unique-strong-admin-password
MANAGER_PASSWORD=replace-with-unique-strong-management-password

# White-label settings
BRAND_NAME=Your Institute
BRAND_TAGLINE=Learning for every student
BRAND_LOGO_URL=/branding/logo.png
BRAND_PRIMARY_COLOR=#D4AF37
BRAND_CONTACT_PHONE=
BRAND_CONTACT_ADDRESS=
BRAND_LOCATION_QR_URL=
PROGRAM_NAME=Student Registration Program
ADMISSION_PREFIX=ST
PORT=5000
MANAGEMENT_PORT=5001

# Landing page social links (full URLs)
BRAND_WHATSAPP_URL=
BRAND_YOUTUBE_URL=
BRAND_INSTAGRAM_URL=
BRAND_TELEGRAM_URL=
# Up to 10 media objects, JSON array: [{"type":"image","url":"https://...","link":"https://..."}]
BRAND_HERO_MEDIA=[]
